{
  "id": "neodex.valse",
  "name": "Valse",
  "version": "2.1.0",
  "author": "NDesumeur",
  "description": "Jeu de rythme à une touche : le soleil et la lune tournent l'un autour de l'autre sur un chemin de dalles dessiné par la musique ; tape pile quand l'astre touche la dalle suivante. Trop tôt ou trop tard, la partie est perdue : on reprend au dernier drapeau (toutes les 32 dalles). Les 1200 morceaux de Rythme notés de 1 à 10 étoiles, ou des niveaux créés depuis ta musique ; combo, note de S à D, manette, entraînement depuis 25, 50 ou 75 % du morceau.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "valse",
  "neobase": ">=4.1.0",
  "type": "app",
  "category": "Jeux",
  "compatibility": [
    "windows",
    "linux"
  ],
  "syncMode": "progression",
  "syncInfo": "Scores et notes par niveau, réglages.",
  "mobile": false,
  "gamepad": true,
  "system": false,
  "dependencies": {
    "neodex.music": ">=1.3.0"
  },
  "sdk": "2.1.0",
  "permissions": [
    "storage",
    "documents",
    "music"
  ],
